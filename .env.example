PORT=3000
JWT_SECRET=meeting_room_booking_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d

# Database Configuration
# Options for DB_CLIENT: 'mysql' or 'sqlite'
# If 'mysql' is selected and local MySQL is offline, the app automatically switches to SQLite fallback for hassle-free demonstration!
DB_CLIENT=mysql
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=meeting_room_db
DB_PORT=3306

# SQLite database file path (used if DB_CLIENT=sqlite or fallback)
SQLITE_DB_PATH=./database.sqlite

